<%- include('partials/head') %><main id="main" class="container auth-layout"><section class="auth-card"><a class="brand" href="/"><img class="brand-mark" src="/images/brand/alpha-gold-mark.png" alt=""><span class="brand-word"><b>ALPHA</b><small>GOLD & JEWELRY</small></span></a><div id="login-phone-step"><span class="eyebrow">خوش آمدید</span><h1>داستان شما از اینجا شروع می‌شود.</h1><p>برای ورود یا ثبت‌نام، شماره موبایل خود را وارد کنید.</p><form id="otp-request"><label>شماره موبایل<input name="phone" type="tel" dir="ltr" inputmode="tel" autocomplete="tel" placeholder="۰۹۱۲۳۴۵۶۷۸۹" required maxlength="16"></label><button class="button full">دریافت کد ورود ←</button></form></div><div id="login-code-step" hidden><h1>کد ورود را وارد کنید</h1><p id="otp-destination"></p><form id="otp-verify"><label>کد ۶ رقمی<input name="code" class="otp-input" dir="ltr" inputmode="numeric" autocomplete="one-time-code" maxlength="6" minlength="6" required></label><button class="button full">ورود به آلفا</button></form><div class="actions"><button class="text-button" id="otp-resend" disabled>ارسال دوباره</button><button class="text-button" id="otp-change">تغییر شماره موبایل</button></div><p id="otp-countdown" class="muted" aria-live="polite"></p></div><p class="form-error" id="login-error" role="alert"></p><% if(otpDemo){ %><p class="notice">کد ورود پس از درخواست در همین صفحه نمایش داده می‌شود.</p><p id="dev-code" class="dev-code" dir="ltr"></p><% } %><small>ورود به معنی پذیرش <a href="/terms">شرایط خرید</a> و <a href="/privacy">حریم خصوصی</a> است.</small></section><section class="auth-art"><div><span>EVERYDAY, BUT EXTRAORDINARY.</span><h2>جزئی از شما.<br>همیشه درخشان.</h2></div></section></main><%- include('partials/footer') %>
