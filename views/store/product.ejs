<%- include('partials/head') %><main id="main" class="container section"><div class="breadcrumbs"><a href="/">آلفا</a> / <a href="/shop">طلای اجرت‌دار</a> / <%= product.name %></div><div class="product-detail"><section class="product-summary"><span class="eyebrow"><%= product.subCategory.name %> · ALPHA</span><h1><%= product.name %></h1><div class="detail-specs"><span>طلای <%= number(product.karat) %> عیار</span><span>وزن <%= number(product.goldWeight) %> گرم</span><span><%= product.stock>0?'موجود':'ناموجود' %></span></div><p class="detail-description"><%= product.description %></p><div class="detail-price"><strong><%= product.priceAvailable ? money(product.price.finalPrice) : 'در انتظار به‌روزرسانی نرخ' %></strong><small>قیمت هر عدد · وزن دقیق مطابق مشخصات</small></div><div class="purchase-row"><label>تعداد<input id="product-quantity" type="number" value="1" min="1" max="<%= Math.min(product.stock,99) %>" aria-label="تعداد محصول"></label><button class="button" data-action="add-cart" data-id="<%= product._id %>" <%= !product.stock||!product.priceAvailable?'disabled':'' %>>افزودن به سبد خرید <%- include('partials/icon',{name:'bag'}) %></button><button class="button secondary" data-action="wishlist" data-id="<%= product._id %>" aria-label="افزودن به علاقه‌مندی‌ها"><%- include('partials/icon',{name:'heart'}) %></button></div>
<% if(product.price){const p=product.price; %><details class="price-breakdown" open><summary>جزئیات قیمت <span>تومان</span></summary><dl><div><dt>ارزش طلا (<%= number(p.goldWeight) %> گرم)</dt><dd><%= money(p.goldValue) %></dd></div><div><dt>اجرت ساخت <%= p.wage.type==='percent'?'('+number(p.wage.value)+'٪)':'ثابت / هر عدد' %></dt><dd><%= money(p.wage.amount) %></dd></div><div><dt>سود فروش (<%= number(p.profit.percent) %>٪)</dt><dd><%= money(p.profit.amount) %></dd></div><div><dt>مالیات اجرت و سود (<%= number(p.tax.percent) %>٪)</dt><dd><%= money(p.tax.amount) %></dd></div><div><dt>متعلقات</dt><dd><%= money(p.accessoriesPrice) %></dd></div><div class="total"><dt>قیمت نهایی</dt><dd><%= money(p.finalPrice) %></dd></div></dl><small>آخرین نرخ: <%= date(product.priceUpdatedAt) %> · مبلغ نهایی در مرحله بازبینی تثبیت می‌شود.</small></details><% } %><a href="/guide" class="text-link">درباره محاسبه قیمت طلا بیشتر بدانید ←</a></section>
<section class="gallery"><div id="main-product-photo"><%- include('partials/photo',{src:product.coverImage,alt:product.name}) %></div><div class="thumbnails"><button data-action="photo" data-src="<%= product.coverImage %>" aria-label="تصویر اصلی"><%- include('partials/photo',{src:product.coverImage,alt:product.name}) %></button><% product.images.filter(x=>x&&!x.includes('default')).forEach(src=>{ %><button data-action="photo" data-src="<%= src %>" aria-label="نمای دیگر محصول"><%- include('partials/photo',{src,alt:product.name}) %></button><% }) %></div><p class="image-note"><%= demo?'تصویر و محصول نمونه، مخصوص نمایش طراحی':'تصاویر را برای مشاهده جزئیات انتخاب کنید.' %></p></section></div>
<section class="product-details-table"><h2>جزئیات این انتخاب</h2><dl><div><dt>کد محصول</dt><dd><%= product.sku %></dd></div><div><dt>عیار</dt><dd><%= number(product.karat) %></dd></div><div><dt>وزن خالص طلا</dt><dd><%= number(product.goldWeight) %> گرم</dd></div><% product.details.forEach(d=>{ %><div><dt><%= d.title %></dt><dd><%= d.value %></dd></div><% }) %></dl></section><section class="section"><div class="section-heading"><h2>شاید این‌ها را هم دوست داشته باشید</h2><a href="/shop">همه زیورآلات ←</a></div><div class="products-grid"><% related.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section></main><%- include('partials/footer') %>
