<article class="product-card"><div class="product-image"><a href="/product/<%= encodeURIComponent(p.slug) %>"><%- include('photo', { src: p.coverImage, alt: p.name }) %></a><button class="wish-button" data-action="wishlist" aria-pressed="<%= wishlistIds.has(String(p._id)) %>" data-id="<%= p._id %>" aria-label="<%= wishlistIds.has(String(p._id)) ? 'حذف از علاقه‌مندی‌ها' : 'افزودن به علاقه‌مندی‌ها' %>"><%- include('icon', { name: 'heart' }) %></button><% if(!p.stock){ %><span class="product-tag">ناموجود</span><% }else if(p.isFeatured){ %><span class="product-tag">منتخب آلفا</span><% } %></div><div class="product-info"><span class="eyebrow">طلای <%= number(p.karat) %> عیار</span><h3><a href="/product/<%= encodeURIComponent(p.slug) %>"><%= p.name %></a></h3><div class="product-meta"><span><%= number(p.goldWeight) %> گرم</span><strong><%= p.priceAvailable ? money(p.price.finalPrice) : 'در انتظار نرخ جدید' %></strong></div></div><%- include('purchase-control',{p}) %></article>
