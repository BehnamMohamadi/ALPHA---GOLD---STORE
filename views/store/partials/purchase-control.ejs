<div class="cart-control" data-purchase="<%= p._id %>" data-stock="<%= p.stock %>" data-available="<%= p.stock>0 && p.priceAvailable && p.isActive!==false %>"><button type="button" class="button cart-add" data-action="cart-add" data-id="<%= p._id %>" <%= !p.stock||!p.priceAvailable||p.isActive===false?'disabled':'' %>><svg class="cart-bag-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg><span><%= p.stock>0 && p.priceAvailable && p.isActive!==false?'افزودن به سبد خرید':'ناموجود / در انتظار نرخ' %></span></button></div>
