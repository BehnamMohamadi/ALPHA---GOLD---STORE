<section class="section container audience-collections" aria-labelledby="audience-title"><div class="section-heading"><div><span class="eyebrow">برای هر سلیقه، برای هر سن</span><h2 id="audience-title">طلایی برای دنیای شما</h2></div><%- include('browse-link') %></div>
<div class="audience-grid"><% [ ['female','women','زنانه','ظرافتی که همراه شماست'], ['male','men','مردانه','جزئیاتی برای امضای استایل شما'], ['kids','children','کودکانه','درخشش کوچک، خاطره‌های بزرگ'] ].forEach(([gender,file,label,caption])=>{ %><a class="audience-card" href="/shop?gender=<%= gender %>"><img src="/images/brand/audience-<%= file %>-v1.png" alt="زیورآلات طلای <%= label %>" width="1254" height="1254" loading="lazy"><div class="audience-copy"><div><small><%= caption %></small><h3>زیورآلات <%= label %></h3></div></div></a><% }) %></div></section>
