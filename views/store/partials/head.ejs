<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | ALPHA</title><meta name="description" content="<%= description %>"><meta name="theme-color" content="#161410">
<% if (demo || path.startsWith('/account') || path.startsWith('/payment') || path === '/checkout') { %><meta name="robots" content="noindex,nofollow"><% } %>
<link rel="icon" href="/images/brand/logo-badge.png?v=alpha" type="image/png"><link rel="preload" href="/fonts/vazirmatn/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/store.css"><link rel="stylesheet" href="/css/brand.css"><script src="/js/store.js" defer></script></head>
<body data-authenticated="<%= Boolean(user) %>" data-demo="<%= demo %>">
<a class="skip-link" href="#main">رفتن به محتوا</a>
<div class="announcement"><span>ALPHA · GOLD JEWELRY</span><span><%= demo ? 'نسخه نمایشی · محصولات و پرداخت‌ها آزمایشی هستند' : 'انتخابی ماندگار، برای لحظه‌های شما' %></span><a href="/guide">راهنمای خرید طلا <span aria-hidden="true">↗</span></a></div>
<div class="alpha-utility"><div class="container"><div><a href="/account"><%= user?'حساب من':'ورود / ثبت‌نام' %></a><a href="/account/wishlist">علاقه‌مندی‌ها</a><a href="/cart">سبد خرید</a></div><a href="/shipping">شرایط ارسال و بازگشت ←</a></div></div><header class="site-header"><div class="header-inner">
<a class="brand" href="/" aria-label="آلفا، صفحه اصلی"><img class="brand-mark" src="/images/brand/logo-seal.png?v=alpha" alt=""><span class="brand-word"><b>ALPHA</b><small>GOLD & JEWELRY</small></span></a>
<form class="alpha-search" action="/shop" method="get"><input type="search" name="q" maxlength="100" placeholder="زیور مورد نظرتان را پیدا کنید…" aria-label="جست‌وجوی زیورآلات"><button aria-label="جست‌وجو"><%- include('icon',{name:'search'}) %></button></form><nav class="desktop-nav" aria-label="منوی اصلی"><a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>">طلای اجرت‌دار</a><% navSubcategories.slice(0,4).forEach(c => { %><a href="/shop?subCategory=<%= c._id %>"><%= c.name %></a><% }) %><a href="/about">داستان آلفا</a></nav>
<div class="header-actions"><a href="/search" aria-label="جست‌وجو"><%- include('icon', { name: 'search' }) %></a><a href="/account" aria-label="حساب کاربری"><%- include('icon', { name: 'user' }) %></a><a href="/cart" aria-label="سبد خرید" class="cart-link"><%- include('icon', { name: 'bag' }) %><span id="cart-count" hidden>0</span></a><button class="mobile-menu" data-action="menu" aria-label="باز کردن منو" aria-expanded="false"><%- include('icon', { name: 'menu' }) %></button></div></div>
<nav id="mobile-nav" hidden aria-label="منوی موبایل"><a href="/shop">همه زیورآلات</a><% navSubcategories.forEach(c => { %><a href="/shop?subCategory=<%= c._id %>"><%= c.name %></a><% }) %><a href="/guide">راهنمای خرید</a><a href="/contact">تماس با ما</a></nav></header>
