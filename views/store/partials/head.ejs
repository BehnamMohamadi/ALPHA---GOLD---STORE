<!doctype html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> | ALPHA</title><meta name="description" content="<%= description %>"><meta name="theme-color" content="#faf9f5">
<% if (demo || path.startsWith('/account') || path.startsWith('/payment') || path === '/checkout') { %><meta name="robots" content="noindex,nofollow"><% } %>
<link rel="icon" href="/images/brand/alpha-gold-mark.png" type="image/png"><link rel="preload" href="/fonts/vazirmatn/Vazirmatn-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/store.css"><link rel="stylesheet" href="/css/brand.css"><link rel="stylesheet" href="/css/proposal.css?v=account-11"><link rel="stylesheet" href="/css/store-components.css?v=readability-2"><% if(path==='/guide'){ %><link rel="stylesheet" href="/css/guide.css?v=responsive-2"><% } %><% if(path.startsWith('/product/')){ %><link rel="stylesheet" href="/css/product-gallery.css?v=1"><% } %><% if(path.startsWith('/account')){ %><link rel="stylesheet" href="/css/account-refresh.css?v=1"><% } %><% if(path==='/'){ %><link rel="stylesheet" href="/css/home-discovery.css?v=photos-2"><% } %><script src="/js/form-feedback.js?v=1" defer></script><script src="/js/storefront-ui.js?v=category-2" defer></script><script src="/js/motion.js?v=4" defer></script><script src="/js/store.js?v=account-14" defer></script><% if(path==='/'){ %><script src="/js/hero-slider.js?v=3" defer></script><% } %></head>
<body data-authenticated="<%= Boolean(user) %>" data-demo="<%= demo %>">
<a class="skip-link" href="#main">رفتن به محتوا</a>
<header class="site-header"><div class="header-inner"><button class="mobile-menu" data-open-menu aria-controls="mobile-drawer" aria-label="باز کردن منو" aria-expanded="false"><%- include('icon', { name: 'menu' }) %></button>
<a class="brand" href="/" aria-label="آلفا، صفحه اصلی"><img class="brand-mark" src="/images/brand/alpha-gold-mark.png" alt=""><span class="brand-word"><b>ALPHA</b><small>GOLD & JEWELRY</small></span></a>
<div class="gold-rate-pill"><span class="rate-emblem" aria-hidden="true">✧</span><span class="rate-label">قیمت هر گرم<small>طلای ۱۸ عیار</small></span><strong><%= rate?.prices?.gold18 ? number(rate.prices.gold18) : '—' %><small><%= rate?.prices?.gold18 ? 'تومان' : 'در انتظار نرخ' %></small></strong></div><div class="header-actions"><a href="/account/wishlist" aria-label="لیست علاقه‌مندی‌ها"><%- include('icon',{name:'heart'}) %></a><a href="/account" aria-label="حساب کاربری"><%- include('icon', { name: 'user' }) %></a><a href="/cart" aria-label="سبد خرید" class="cart-link"><%- include('icon', { name: 'bag' }) %><span id="cart-count" hidden>0</span></a></div><div class="header-navigation"><form class="alpha-search" action="/shop" method="get"><input type="search" name="q" maxlength="100" placeholder="نام محصول یا کد مورد نظرتان را وارد کنید..." aria-label="جست‌وجوی زیورآلات"><button aria-label="جست‌وجو" disabled><%- include('icon',{name:'search'}) %></button></form><% const earringNav = navSubcategories.find(c => String(c.name || '').trim() === 'گوشواره' || c.slug === 'گوشواره'); const mainNavSubs = navSubcategories.filter(c => !earringNav || String(c._id) !== String(earringNav._id)).slice(0,4); %><nav class="desktop-nav" aria-label="منوی اصلی"><a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>">طلای اجرت‌دار</a><% mainNavSubs.forEach(c => { %><a href="/shop?subCategory=<%= c._id %>"><%= c.name %></a><% }) %><a href="/shop?subCategory=<%= earringNav?._id || 'گوشواره' %>">گوشواره</a></nav></div></div>
</header><dialog id="mobile-drawer" aria-label="منوی آلفا"><div class="drawer-content"><div class="drawer-heading"><span>دنیای آلفا</span><button data-close-menu aria-label="بستن منو">×</button></div><nav id="mobile-nav" aria-label="منوی موبایل"><a href="/shop">همه زیورآلات</a><% navSubcategories.forEach(c => { %><a href="/shop?subCategory=<%= c._id %>"><%= c.name %></a><% }) %><a href="/guide">راهنمای خرید</a><a href="/contact">تماس با ما</a><a href="/account">حساب کاربری</a><a href="/account/wishlist">علاقه‌مندی‌ها</a></nav></div></dialog>
