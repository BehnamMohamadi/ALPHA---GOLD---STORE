<%- include('partials/head') %><main id="main" class="container section"><div class="page-heading"><div><span class="eyebrow">YOUR ALPHA</span><h1>خوش آمدید، <%= user.firstname %></h1></div><a class="text-link" href="/shop">یک انتخاب تازه ←</a></div><div class="account-layout"><aside class="account-nav"><div class="account-avatar"><%- include('partials/icon',{name:'user'}) %><b><%= user.firstname %> <%= user.lastname %></b><span dir="ltr"><%= user.phonenumber %></span></div><% [['overview','حساب من'],['orders','سفارش‌های من'],['addresses','آدرس‌ها'],['wishlist','علاقه‌مندی‌ها'],['profile','پروفایل و امنیت'],['support','پشتیبانی']].forEach(([key,label])=>{ %><a href="/account<%= key==='overview'?'':'/'+key %>" class="<%= section===key?'active':'' %>"><%= label %><span>←</span></a><% }) %><% if(user.role==='admin'){ %><a class="account-admin-link" href="/admin">پنل مدیریت <span>↗</span></a><% } %><button data-action="logout" class="text-button">خروج از حساب</button></aside><section id="account-page" data-section="<%= section %>" data-order="<%= orderId %>" data-invoice="<%= invoice %>"><div class="loading">در حال دریافت اطلاعات…</div></section></div></main><%- include('partials/footer') %>
