<%- include('partials/head') %><main id="main">
<%- include('partials/hero-slider') %>
<section class="alpha-benefits container" aria-label="راهنمای خدمات فروشگاه"><a href="/guide"><b>وزن و عیار مشخص</b><span>مشخصات کامل هر زیور ←</span></a><a href="/guide"><b>قیمت شفاف طلا</b><span>تفکیک اجرت، سود و مالیات ←</span></a><a href="/account/orders"><b>پیگیری سفارش</b><span>از خرید تا تحویل در حساب شما ←</span></a><a href="/shipping"><b>ارسال و بازگشت</b><span>شرایط خرید را ببینید ←</span></a></section>
<%- include('partials/category-discovery') %>
<section class="collection-showcase container" aria-labelledby="collection-title">
<header class="collection-showcase-heading"><div><h2 id="collection-title">زیورآلات آلفا</h2><a class="collection-all" href="/shop">مشاهده همه زیورآلات <span aria-hidden="true">←</span></a></div><div class="collection-signature"><span dir="ltr"><b>ALPHA</b><small>GOLD & JEWELRY</small></span><p>طلایی که با شما معنا می‌گیرد</p></div></header>
<div class="collection-showcase-grid"><a class="collection-feature collection-feature-main" href="/shop"><img src="/images/brand/collection-necklace-v2.png" width="1402" height="1122" alt="گردنبند طلایی با آویز گیاهی روی لباس روشن" loading="lazy"><div class="collection-feature-copy"><h3>زیبایی برای هر روز</h3></div></a><a class="collection-feature" href="/shop"><img src="/images/brand/collection-earrings-v2.png" width="1706" height="922" alt="گوشواره‌های حلقه‌ای طلا روی سنگ روشن" loading="lazy"><div class="collection-feature-copy"><h3>درخشش در جزئیات</h3></div></a><a class="collection-feature" href="/shop"><img src="/images/brand/collection-bracelet-v2.png" width="1706" height="922" alt="دستبند طلایی روی پارچه ابریشمی روشن" loading="lazy"><div class="collection-feature-copy"><h3>انتخابی برای شما</h3></div></a></div></section>
<section class="section container"><div class="section-heading"><div><span class="eyebrow">سادگی، همیشه زیباست</span><h2>تازه‌های مجموعه آلفا</h2></div><a class="browse-products" href="/shop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>مشاهده همه محصولات</span></a></div><p class="rail-hint" id="collection-hint"><span class="drag-cue" aria-hidden="true"></span>برای دیدن بیشتر بکشید</p><div class="products-grid collection-rail" data-product-rail tabindex="0" role="region" aria-label="تازه‌های مجموعه آلفا" aria-describedby="collection-hint"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %><% if(!products.length){ %><p class="empty">در حال آماده‌سازی مجموعه جدید هستیم.</p><% } %></div></section>
<%- include('partials/audience-collections') %>
<section class="section container guide-banner"><div><span class="eyebrow">خرید آگاهانه</span><h2>قیمت طلای شما چطور محاسبه می‌شود؟</h2><p>از وزن و عیار تا اجرت و مالیات؛ همه‌چیز روشن و قابل بررسی.</p></div><a class="button secondary" href="/guide">راهنمای خرید طلا ←</a></section>

