          <span>مشاهده محصولات <i aria-hidden="true">←</i></span>
        </div>
      </a>

      <a class="alpha-price-card" href="/shop?minPrice=8000000&maxPrice=11999999&sort=price" aria-label="مشاهده محصولات بین ۸ تا ۱۲ میلیون تومان">
        <div class="alpha-price-card__visual">
          <span class="alpha-price-card__kicker">ALPHA SELECT</span><span class="alpha-price-card__orbit" aria-hidden="true"></span>
          <div class="alpha-price-card__number"><b>۸</b><i>—</i><b>۱۲</b></div>
        </div>
        <div class="alpha-price-card__body">
          <strong>از ۸ تا ۱۲ میلیون تومان</strong>
