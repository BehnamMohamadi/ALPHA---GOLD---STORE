<%- include('partials/head') %><main id="main" class="container section shop-page"><div class="breadcrumbs"><a href="/">آلفا</a> / زیورآلات</div><div class="page-heading"><div><span class="eyebrow">THE ALPHA COLLECTION</span><h1><%= title %></h1><p>طلایی که برازنده شماست.</p><% if(Number(query.minPrice)>0 || Number(query.maxPrice)>0){ const minM=Number(query.minPrice)>0?Number(query.minPrice)/1000000:null; const maxM=Number(query.maxPrice)>0?Number(query.maxPrice)/1000000:null; %><span class="active-price-filter">بازه قیمت: <%= minM ? number(minM) : '۰' %> تا <%= maxM ? number(Math.ceil(maxM)) : 'بالاتر' %> میلیون تومان</span><% } %></div><span><%= number(pagination.total) %> محصول</span></div>
<section class="catalog-search" aria-label="جست‌وجوی محصولات"><label for="catalog-query">جست‌وجو در محصولات</label><form class="search-box" action="/shop"><%- include('partials/icon',{name:'search'}) %><input id="catalog-query" name="q" type="search" required maxlength="100" aria-label="جست‌وجوی محصول" placeholder="نام محصول یا کد مورد نظرتان را وارد کنید..." value="<%= query.q || '' %>"><button class="button" <%= !(query.q || '').trim() ? 'disabled' : '' %>>جست‌وجو</button></form><% if(query.q && pagination.total === 0){ %><p class="search-no-results" role="status">محصول مورد نظر پیدا نشد.</p><% } %>
</section><div class="catalog-layout"><aside class="filters"><form action="/shop"><h2>فیلتر محصولات</h2><label>کالکشن<select name="gender"><option value="">همه کالکشن‌ها</option><% [['female','زنانه'],['male','مردانه'],['kids','بچه‌گانه'],['unisex','زنانه و مردانه (مشترک)']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= query.gender===value?'selected':'' %>><%= label %></option><% }) %></select></label><% if(query.q){ %><input type="hidden" name="q" value="<%= query.q %>"><% } %><label>نوع زیور<select name="subCategory"><option value="">همه زیورآلات</option><% subcategories.forEach(c=>{ %><option value="<%= c._id %>" <%= String(query.subCategory)===String(c._id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>عیار<select name="karat"><option value="">همه عیارها</option><% [18,21,22,24].forEach(k=>{ %><option value="<%= k %>" <%= Number(query.karat)===k?'selected':'' %>><%= number(k) %> عیار</option><% }) %></select></label><label>حداکثر وزن (گرم)<input type="number" name="maxWeight" step="0.01" min="0.01" value="<%= query.maxWeight || '' %>"></label><label>قیمت از (تومان)<input type="text" inputmode="numeric" autocomplete="off" class="price-filter-input" name="minPrice" data-price-input value="<%= query.minPrice || '' %>"></label><label>قیمت تا (تومان)<input type="text" inputmode="numeric" autocomplete="off" class="price-filter-input" name="maxPrice" data-price-input value="<%= query.maxPrice || '' %>"></label><label>مرتب‌سازی<select name="sort"><% [['-createdAt','جدیدترین'],['price','کمترین قیمت'],['-price','بیشترین قیمت'],['weight','کمترین وزن']].forEach(([v,t])=>{ %><option value="<%= v %>" <%= query.sort===v?'selected':'' %>><%= t %></option><% }) %></select></label><label class="check"><input type="checkbox" name="available" value="true" <%= query.available==='true'?'checked':'' %>>فقط کالاهای موجود</label><button class="button full">اعمال فیلتر</button><a class="reset" href="/shop">حذف فیلترها</a></form></aside>
<div><div class="products-grid catalog-products"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div><% if(!products.length){ %><div class="empty"><h2><%= query.subCategory || query.gender ? "هنوز محصولی در این بخش قرار نگرفته" : "چیزی پیدا نشد" %></h2><p>می‌توانید سایر زیورآلات آلفا را ببینید یا فیلترها را تغییر دهید.</p><a href="/shop" class="button secondary">مشاهده همه محصولات</a></div><% } %><nav class="pagination" aria-label="صفحه‌بندی"><% for(let i=Math.max(1,pagination.page-2);i<=Math.min(pagination.pages,pagination.page+2);i++){const params=new URLSearchParams(query);params.set('page',i); %><a class="<%= i===pagination.page?'active':'' %>" href="/shop?<%= params.toString() %>"><%= number(i) %></a><% } %></nav></div></div></main><%- include('partials/footer') %>
