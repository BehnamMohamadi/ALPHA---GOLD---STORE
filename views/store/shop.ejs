<%- include('partials/head') %><main id="main" class="container section"><div class="breadcrumbs"><a href="/">آلفا</a> / زیورآلات</div><div class="page-heading"><div><span class="eyebrow">THE ALPHA COLLECTION</span><h1><%= title %></h1><p>طلایی که با سلیقه‌ی شما همراه می‌شود.</p></div><span><%= number(pagination.total) %> محصول</span></div>
<form class="search-box" action="/search"><%- include('partials/icon',{name:'search'}) %><input name="q" aria-label="جست‌وجوی محصول" placeholder="دنبال چه طلایی می‌گردید؟" value="<%= query.q || '' %>"><button class="button">جست‌وجو</button></form>
<div class="catalog-layout"><aside class="filters"><form action="/shop"><h2>فیلتر محصولات</h2><% if(query.q){ %><input type="hidden" name="q" value="<%= query.q %>"><% } %><label>نوع زیور<select name="subCategory"><option value="">همه زیورآلات</option><% subcategories.forEach(c=>{ %><option value="<%= c._id %>" <%= String(query.subCategory)===String(c._id)?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>عیار<select name="karat"><option value="">همه عیارها</option><% [18,21,22,24].forEach(k=>{ %><option value="<%= k %>" <%= Number(query.karat)===k?'selected':'' %>><%= number(k) %> عیار</option><% }) %></select></label><label>حداکثر وزن (گرم)<input type="number" name="maxWeight" step="0.01" min="0.01" value="<%= query.maxWeight || '' %>"></label><label>قیمت از (تومان)<input type="number" name="minPrice" min="0" value="<%= query.minPrice || '' %>"></label><label>قیمت تا (تومان)<input type="number" name="maxPrice" min="0" value="<%= query.maxPrice || '' %>"></label><label>مرتب‌سازی<select name="sort"><% [['-createdAt','جدیدترین'],['price','کمترین قیمت'],['-price','بیشترین قیمت'],['weight','کمترین وزن']].forEach(([v,t])=>{ %><option value="<%= v %>" <%= query.sort===v?'selected':'' %>><%= t %></option><% }) %></select></label><label class="check"><input type="checkbox" name="available" value="true" <%= query.available==='true'?'checked':'' %>>فقط کالاهای موجود</label><button class="button full">اعمال فیلتر</button><a class="reset" href="/shop">حذف فیلترها</a></form></aside>
<div><div class="products-grid catalog-products"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div><% if(!products.length){ %><div class="empty"><h2>چیزی پیدا نشد</h2><p>عبارت جست‌وجو یا فیلترها را تغییر دهید.</p><a href="/shop" class="button secondary">مشاهده همه محصولات</a></div><% } %><nav class="pagination" aria-label="صفحه‌بندی"><% for(let i=Math.max(1,pagination.page-2);i<=Math.min(pagination.pages,pagination.page+2);i++){const params=new URLSearchParams(query);params.set('page',i); %><a class="<%= i===pagination.page?'active':'' %>" href="/shop?<%= params.toString() %>"><%= number(i) %></a><% } %></nav></div></div></main><%- include('partials/footer') %>
