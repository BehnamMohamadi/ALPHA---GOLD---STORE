<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | ALPHA</title>
  <link rel="stylesheet" href="/css/admin/admin.css">
<link rel="stylesheet" href="/css/admin/alpha.css"><link rel="stylesheet" href="/css/admin/refined.css?v=2"></head>
<body>
<div class="admin-layout">
  <%- include("partials/sidebar", { activePage: "products", adminUser }) %>

  <main class="admin-main">
    <%- include("partials/topbar", {
      pageTitle: productId ? "ویرایش محصول" : "افزودن محصول",
      pageSubtitle: "اطلاعات محصول، قیمت‌گذاری، موجودی و تصاویر"
    }) %>

    <div
      id="productFormPage"
      data-product-id="<%= typeof productId !== 'undefined' ? productId : '' %>"
    ></div>

    <div
      id="productFormErrors"
      class="form-errors hidden"
      role="alert"
      aria-live="polite"
    ></div>

    <form id="productForm" class="form-layout" novalidate>
      <section class="panel">
        <div class="panel-head">
          <div><h2>اطلاعات اصلی</h2></div>
        </div>

        <div class="form-grid">
          <label class="field">
            <span>نام محصول *</span>
            <input name="name" minlength="2" maxlength="100">
          </label>

          <label class="field">
            <span>SKU *</span>
            <input name="sku">
          </label>

          <label class="field">
            <span>Slug</span>
            <input
              name="slug"
              placeholder="در صورت خالی بودن از نام ساخته می‌شود"
            >
          </label>

          <label class="field">
            <span>جنسیت *</span>
            <select name="gender">
              <option value="">انتخاب کنید</option>
              <option value="female">زنانه</option>
              <option value="male">مردانه</option>
              <option value="kids">کودک</option>
              <option value="unisex">یونیسکس</option>
            </select>
          </label>

          <label class="field">
            <span>دسته‌بندی *</span>
            <select name="category" id="categorySelect"></select>
          </label>

          <label class="field">
            <span>زیردسته *</span>
            <select name="subCategory" id="subCategorySelect"></select>
          </label>

          <label class="field">
            <span>وزن طلا (گرم) *</span>
            <input
              type="number"
              step="0.01"
              min="0.01"
              name="goldWeight"
            >
          </label>

          <label class="field">
            <span>عیار *</span>
            <select name="karat">
              <option value="18">۱۸</option>
              <option value="21">۲۱</option>
              <option value="22">۲۲</option>
              <option value="24">۲۴</option>
            </select>
          </label>

          <label class="field">
            <span>موجودی</span>
            <input type="number" min="0" name="stock" value="0">
          </label>

          <label class="field">
            <span>قیمت متعلقات</span>
            <input
              type="number"
              min="0"
              name="accessoriesPrice"
              value="0"
            >
          </label>

          <label class="field">
            <span>نوع اجرت سفارشی</span>
            <select name="wageType">
              <option value="percent">درصدی</option>
              <option value="fixed">ثابت</option>
            </select>
          </label>

          <label class="field">
            <span>مقدار اجرت سفارشی</span>
            <input
              type="number"
              min="0"
              step="0.01"
              name="wageValue"
              value="0"
            >
          </label>

          <label class="field">
            <span>نوع قیمت‌گذاری</span>
            <select name="pricingMode">
              <option value="standard">استاندارد</option>
              <option value="custom">سفارشی</option>
            </select>
          </label>

          <div
            id="pricingModeNotice"
            class="full"
            role="status"
            aria-live="polite"
            data-mode=""
            style="padding:12px 14px;border:1px solid #dfd6c6;border-radius:8px;background:#f8f5ee;color:#665b48;font-size:12px;line-height:2;"
          ></div>

          <label class="field">
            <span>درصد سود سفارشی</span>
            <input
              type="number"
              min="0"
              step="0.01"
              name="profitPercent"
              placeholder="خالی = مقدار عمومی"
            >
          </label>

          <label class="field">
            <span>درصد مالیات سفارشی</span>
            <input
              type="number"
              min="0"
              step="0.01"
              name="taxPercent"
              placeholder="خالی = مقدار عمومی"
            >
          </label>

          <div class="field toggle-field">
            <span>اعمال اجرت سفارشی</span>
            <label class="switch">
              <input type="checkbox" name="wageEnabled" aria-label="اعمال اجرت سفارشی" checked>
              <i></i>
            </label>
          </div>

          <div class="field toggle-field">
            <span>محصول فعال</span>
            <label class="switch">
              <input type="checkbox" name="isActive" aria-label="فعال بودن" checked>
              <i></i>
            </label>
          </div>

          <div class="field toggle-field">
            <span>محصول ویژه</span>
            <label class="switch">
              <input type="checkbox" name="isFeatured" aria-label="محصول منتخب">
              <i></i>
            </label>
          </div>

          <label class="field full">
            <span>توضیحات</span>
            <textarea
              name="description"
              rows="6"
              maxlength="5000"
            ></textarea>
          </label>
        </div>
      </section>

      <aside class="form-side">
        <section class="panel" id="imagePanel">
          <div class="panel-head">
            <div><h2>تصاویر محصول</h2></div>
          </div>

          <div class="cover-preview">
            <img id="coverPreview" src="" alt="">
          </div>

          <label class="upload-box">
            <input type="file" id="coverFile" accept="image/*">
            <span>انتخاب تصویر کاور</span>
          </label>
          <p style="margin:8px 0 18px;font-size:12px;color:#7a7467;line-height:1.9;">
            تصویر کاور را قبل از آپلود به نسبت ۱:۱ (مربع) آماده کنید.
          </p>

          <div class="gallery-preview" id="galleryPreview"></div>

          <label class="upload-box">
            <input
              type="file"
              id="galleryFiles"
              accept="image/*"
              multiple
            >
            <span>انتخاب تصاویر گالری (حداکثر ۱۰)</span>
          </label>
          <p style="margin:8px 0 0;font-size:12px;color:#7a7467;line-height:1.9;">
            هر تصویر گالری را قبل از آپلود به نسبت ۱:۱ (مربع) آماده کنید.
          </p>
        </section>

        <section class="panel">
          <div class="panel-head">
            <div><h2>ویژگی‌های تکمیلی</h2></div>
          </div>

          <div
            id="detailsContainer"
            class="details-builder"
          ></div>

          <button
            type="button"
            id="addDetailButton"
            class="btn btn-secondary full-btn"
          >
            + افزودن ویژگی
          </button>
        </section>

        <div class="sticky-actions">
          <a class="btn btn-secondary" href="/admin/products">
            انصراف
          </a>

          <button
            class="btn btn-gold"
            type="submit"
            id="saveProductButton"
          >
            ذخیره محصول
          </button>
        </div>
      </aside>
    </form>
  </main>
</div>

<%- include("partials/scripts") %>
<script src="/js/admin/product-form.js"></script>
<script>
(() => {
  const form = document.getElementById("productForm");
  const modeSelect = form?.elements?.pricingMode;
  const notice = document.getElementById("pricingModeNotice");

  if (!form || !modeSelect || !notice) return;

  const renderPricingModeNotice = () => {
    const mode = modeSelect.value === "custom" ? "custom" : "standard";
    if (notice.dataset.mode === mode) return;

    notice.dataset.mode = mode;

    if (mode === "custom") {
      notice.innerHTML = "<strong>قیمت‌گذاری سفارشی فعال است.</strong><br>اجرت، سود و مالیات سفارشی همین محصول در محاسبه قیمت استفاده می‌شوند. نرخ طلا همچنان از تنظیمات عمومی فروشگاه خوانده می‌شود.";
      notice.style.background = "#f4efe4";
      notice.style.borderColor = "#b89a63";
      notice.style.color = "#5f4a28";
      return;
    }

    notice.innerHTML = "<strong>قیمت‌گذاری استاندارد فعال است.</strong><br>اجرت، سود و مالیات از تنظیمات عمومی قیمت‌گذاری فروشگاه خوانده می‌شوند. مقادیر سفارشی این فرم ذخیره می‌شوند اما تا زمانی که حالت «سفارشی» را انتخاب نکنید، در قیمت محصول استفاده نمی‌شوند.";
    notice.style.background = "#f8f5ee";
    notice.style.borderColor = "#dfd6c6";
    notice.style.color = "#665b48";
  };

  modeSelect.addEventListener("change", renderPricingModeNotice);

  const observer = new MutationObserver(renderPricingModeNotice);
  observer.observe(form, { childList: true, subtree: true });

  renderPricingModeNotice();
  window.addEventListener("load", renderPricingModeNotice, { once: true });
})();
</script>
</body>
</html>
